# NexaRAG Environment Configuration Example
# Copy to .env and configure appropriately for local deployment

# Project Metadata
PROJECT_NAME=NexaRAG
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Security & Auth
SECRET_KEY=nexarag-insecure-dev-secret-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connections
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexarag
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nexarag

# LLM Provider Configuration
# Supported options: 'mock', 'gemini', 'groq'
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# Provider API Keys (leave empty when using 'mock')
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ingestion & Chunking
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNKING_STRATEGY=sentence_aware

# Embeddings & Vector Search
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
TOP_K=5
TOP_N_CANDIDATES=20
SIMILARITY_THRESHOLD=0.3
HYBRID_ALPHA=0.7

# Reranking
RERANKING_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Context Orchestration & Budgets (Phase 11)
MAX_CONTEXT_TOKENS=6000
MAX_RAG_CONTEXT_TOKENS=4000
MAX_CAG_CONTEXT_TOKENS=1500
MAX_MAG_CONTEXT_TOKENS=1000
MAX_CONVERSATION_TOKENS=1000
MIN_CONTEXT_SCORE=0.0
